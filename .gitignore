.env
# Local-only Claude session guide; intentionally not tracked.
CLAUDE.md
__pycache__/
*.pyc

# Cluster run artifacts: the chunk file is generated by make_chunks.py, logs by Slurm.
cluster/neuron_chunks.txt
cluster/logs/

# report_assets.py's own tmp render workspace, normally self-cleaning; a leftover here
# means a render() call was interrupted before its own cleanup ran.
scratch_render/
*.egg-info/
build/
.import_linter_cache/
checkpoints/
.ipynb_checkpoints/
output/
references/
documentation/

# run_perframe.py results (config.json / scores.csv / montages): regenerable per run.
# The headline of each run is kept instead in docs/explanation/perframe-experiments.md.
results/

# Generated run logs from experiments/ are disposable (findings live in PIPELINE_HISTORY old §8).
experiments/*.log

# Generated eval results (per-run CSVs + measurement logs) — project-generated, not source.
eval/out_gt*/
# Generated A/B campaign reports (experiments/ab_eval.py) — project-generated, not source.
experiments/ab_eval/

# Vendored upstream SAM2 example notebooks (~24 MB) — reference only, not project code.
examples/
# Cached vendor API docs (SAM2/SAM3/napari/pgf-tikz PDFs and notebooks, ~41 MB) — reference
# only, not authored, same reasoning as examples/ above.
api_docs/

# Rendered presentation assets (per-frame renders, videos): large, regenerable from the source
# scripts in experiments/, kept on F: instead of in git. The presentation/ deck itself (Slidev
# markdown) is small and stays tracked; only the bulky rendered output lives here.
docs/figures/presentation/

# data/ contents are not committed (CATMAID-derived + large GT). Track only the
# groundtruth scaffold README and the permanent neuron identity registry.
# (`data/*` not `data/` so git descends to find the negations.)
data/*
!data/groundtruth/
data/groundtruth/*
!data/groundtruth/README.md
!data/neuron_registry.csv
